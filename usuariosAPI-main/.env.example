# ============================================================
# Copia este archivo como .env y completa los valores.
# Spring Boot lo lee automaticamente (spring.config.import en
# application.properties). Las variables de entorno del sistema
# tienen prioridad sobre las de este archivo.
#
# NO subas el archivo .env al repositorio: ya esta en .gitignore.
# ============================================================

# --- Conexion MySQL / MariaDB ---
# IMPORTANTE: la URL debe incluir el nombre de la base de datos (/usuarios).
# Sin el, la conexion se abre pero cada consulta falla con
# "No database selected" y la API responde 500.
#
# Local:
DB_URL=jdbc:mysql://localhost:3307/usuarios?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# AWS RDS (el cifrado TLS va activo por defecto, no hace falta useSSL=false):
# DB_URL=jdbc:mysql://<host>.rds.amazonaws.com/usuarios?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- AWS S3 (imagenes de productos) ---
# Credenciales con permisos s3:PutObject, s3:GetObject y s3:DeleteObject
# sobre el bucket indicado.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Necesario solo si usas credenciales temporales (AWS_SESSION_TOKEN).
AWS_SESSION_TOKEN=

AWS_REGION=us-east-2
AWS_S3_BUCKET=apirest-productos-imagenes-proyecto

# --- CORS del frontend Angular ---
CORS_ORIGINS=http://frontend-tienda-nido.s3-website.us-east-2.amazonaws.com
